{
  // The Worker name. IMPORTANT: this must match the Worker name you see in the
  // Cloudflare dashboard, otherwise `wrangler deploy` creates a separate Worker.
  "name": "portfolio-me",
  "compatibility_date": "2026-10-20",

  // Tells `wrangler deploy` exactly where the static site lives.
  // Setting this makes wrangler skip its automatic framework/asset detection,
  // which is what was producing:
  //   "Could not detect a directory containing static files"
  "assets": {
    "directory": "./public"
  },

  // Observability settings — kept in sync with the Cloudflare dashboard
  // (Settings > Observability). If you change these in the dashboard, update
  // this block too, or Cloudflare will warn you about drift.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
